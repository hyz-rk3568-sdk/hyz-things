# RK3568 /userdata/hyz-things/.env (root:root, mode 0600)
# Optional Aliyun IPv6 DDNS: updates one existing default-line AAAA record.
# The portal derives its HTTPS hostname from the same domain/RR pair.
# ALIYUN_ACCESS_KEY_ID=replace-with-access-key-id
# ALIYUN_ACCESS_KEY_SECRET=replace-with-access-key-secret
# ALIYUN_DOMAIN=example.invalid
# ALIYUN_RR=home
# RR=@ uses the domain itself. Direct access uses the Things listener port.
# For a configured HTTPS reverse proxy on 443, optionally set:
# HYZ_THINGS_PUBLIC_PORT=443
# Use a strong random bearer token and the same value as the PC's --ws-token-file.
# The application accepts standard bearer-token characters without a fixed length.
HYZ_THINGS_CODEX_WS_TOKEN=replace-with-capability-token
# Absolute path on the Codex PC (not on the RK3568). Must contain .agents/skills and flashcards/.
# Replace with the real output of `pwd -P` in your PC's hyz-things checkout.
HYZ_THINGS_CODEX_CWD=/home/your-user/hyz_things
